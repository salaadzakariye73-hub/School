# MongoDB Atlas connection string (Required for backend database)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dugsiga_sms?retryWrites=true&w=majority
MONGODB_URI=

# Allowed frontend origin for CORS when frontend and backend are hosted separately (e.g. Cloudflare Pages -> Render)
# Example: https://dugsiga-school.pages.dev
CORS_ORIGIN=

# Optional server port (Render injects PORT automatically; local/AI Studio uses 3000)
PORT=3000

# Frontend API URL (Leave empty when served from the same Express server; set to Render backend URL on Cloudflare Pages)
# Example: https://dugsiga-api.onrender.com
VITE_API_URL=
